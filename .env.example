# GROQ_API_KEY: Free, fast AI inference (LLaMA models). Get at https://console.groq.com
GROQ_API_KEY="MY_GROQ_API_KEY"

# Optional fallback/provider for image analysis. OpenRouter supports vision models.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Gemini chat and image generation models (use current 2.5 model IDs)
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image-preview"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
